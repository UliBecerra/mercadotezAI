---
import Layout from "../../layouts/Layout.astro";
import businesses from "../../data/businesses.json";
import QRCode from "qrcode";

export async function getStaticPaths() {
    return businesses.map((business) => ({
        params: { id: business.id },
        props: { business },
    }));
}

const { business } = Astro.props;

// Use localhost during dev, or live URL
// Note: In production you should use your actual domain, e.g., https://mercadotez.netlify.app
const currentUrl = `https://mercadotez.netlify.app/business/${business.id}`;
// Generate QR as Data URI (Server Side)
const qrCodeDataUri = await QRCode.toDataURL(currentUrl, {
    width: 200,
    margin: 2,
});

const whatsappLink = `https://wa.me/52${business.phone.replace(/\D/g, "")}?text=Hola, vi su negocio en Mercadotez y me gustaría más información.`;
const mapsEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(business.location + ", Teziutlán, Puebla")}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
---

<Layout title={`${business.name} - Mercadotez`}>
    <main class="min-h-screen p-4 md:p-8 max-w-4xl mx-auto">
        {/* Navigation */}
        <a
            href="/"
            class="inline-flex items-center text-neutral-600 dark:text-white/80 hover:text-neutral-900 dark:hover:text-white mb-6 transition-colors group"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 mr-2 transform group-hover:-translate-x-1 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Volver al Directorio
        </a>

        {/* Main Content Card */}
        <div
            class="glass-panel p-0 overflow-hidden relative group animate-fade-in-up bg-white/80 dark:bg-neutral-900/80 backdrop-blur-xl border border-neutral-200 dark:border-white/10 shadow-xl rounded-2xl"
        >
            {/* Hero Header */}
            <div class="relative h-64 md:h-80 w-full overflow-hidden">
                <img
                    src={business.image !== "/images/placeholder.jpg"
                        ? business.image
                        : `https://ui-avatars.com/api/?name=${business.name}&background=random&size=800`}
                    alt={business.name}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-t from-white/90 via-white/20 to-transparent dark:from-black/90 dark:via-black/50 dark:to-transparent"
                >
                </div>

                <div class="absolute bottom-0 left-0 p-6 md:p-8 w-full">
                    <span
                        class="px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 dark:bg-blue-500/20 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-500/30 backdrop-blur-md mb-3 inline-block"
                    >
                        {business.category}
                    </span>
                    <h1
                        class="text-3xl md:text-5xl font-bold text-neutral-900 dark:text-white mb-2 leading-tight"
                    >
                        {business.name}
                    </h1>
                    <p
                        class="text-neutral-700 dark:text-white/80 text-lg flex items-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 mr-2 text-red-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            ></path>
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        {business.location}
                    </p>
                </div>
            </div>

            {/* Details Grid (Restored to Grid) */}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 p-6 md:p-8">
                {/* Info Column (Left) */}
                <div class="md:col-span-2 space-y-6">
                    <div>
                        <h2
                            class="text-xl font-semibold text-neutral-900 dark:text-white mb-3 flex items-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6 mr-2 text-purple-400"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                            Sobre el negocio
                        </h2>
                        <p
                            class="text-neutral-600 dark:text-white/70 leading-relaxed text-lg"
                        >
                            {business.description}
                        </p>
                    </div>

                    {/* Action Buttons */}
                    <div class="flex flex-wrap gap-4 pt-4">
                        <a
                            href={whatsappLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex-1 min-w-[200px] bg-green-600 hover:bg-green-500 text-white font-bold py-4 px-6 rounded-xl transition-all transform hover:scale-[1.02] flex items-center justify-center shadow-lg shadow-green-900/20"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6 mr-2"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                                ></path>
                            </svg>
                            Contactar por WhatsApp
                        </a>

                        <a
                            href={`tel:${business.phone}`}
                            class="flex-1 min-w-[200px] bg-neutral-100 hover:bg-neutral-200 dark:bg-white/10 dark:hover:bg-white/20 text-neutral-900 dark:text-white font-bold py-4 px-6 rounded-xl transition-all flex items-center justify-center border border-neutral-200 dark:border-white/10 backdrop-blur-sm"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6 mr-2"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path>
                            </svg>
                            Llamar: {business.phone}
                        </a>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6">
                        {/* Payment Methods (Moved to Left) */}
                        <div
                            class="bg-neutral-50 dark:bg-black/20 p-6 rounded-xl border border-neutral-200 dark:border-white/10 backdrop-blur-sm shadow-sm"
                        >
                            <h3
                                class="text-neutral-900 dark:text-white font-bold mb-4 flex items-center"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 mr-2 text-green-400"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                                    ></path>
                                </svg>
                                Métodos de Pago
                            </h3>
                            <div class="flex flex-wrap gap-2">
                                <span
                                    class="px-3 py-1 bg-white dark:bg-white/5 border border-neutral-200 dark:border-white/10 rounded-lg text-xs text-neutral-600 dark:text-white/80"
                                    >Efectivo 💵</span
                                >
                                <span
                                    class="px-3 py-1 bg-white dark:bg-white/5 border border-neutral-200 dark:border-white/10 rounded-lg text-xs text-neutral-600 dark:text-white/80"
                                    >Transferencia 🏦</span
                                >
                                <span
                                    class="px-3 py-1 bg-white dark:bg-white/5 border border-neutral-200 dark:border-white/10 rounded-lg text-xs text-neutral-600 dark:text-white/80"
                                    >Tarjeta 💳</span
                                >
                            </div>
                        </div>

                        {/* Amenities (Moved to Left) */}
                        <div
                            class="bg-neutral-50 dark:bg-black/20 p-6 rounded-xl border border-neutral-200 dark:border-white/10 backdrop-blur-sm shadow-sm"
                        >
                            <h3
                                class="text-neutral-900 dark:text-white font-bold mb-4 flex items-center"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 mr-2 text-purple-400"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                                    ></path>
                                </svg>
                                Servicios Adicionales
                            </h3>
                            <ul
                                class="space-y-2 text-sm text-neutral-600 dark:text-white/70"
                            >
                                <li class="flex items-center">
                                    <svg
                                        class="w-4 h-4 mr-2 text-blue-400"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"></path></svg
                                    > Estacionamiento
                                </li>
                                <li class="flex items-center">
                                    <svg
                                        class="w-4 h-4 mr-2 text-blue-400"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"></path></svg
                                    > Wi-Fi Gratis
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                {/* Sidebar Column (Right) */}
                <div class="md:col-span-1 space-y-6">
                    {/* Map */}
                    <div
                        class="bg-neutral-100 dark:bg-black/40 rounded-xl overflow-hidden border border-neutral-200 dark:border-white/10 shadow-inner h-64 relative min-h-[250px]"
                    >
                        <iframe
                            width="100%"
                            height="100%"
                            style="border:0; position: absolute; inset: 0;"
                            loading="lazy"
                            allowfullscreen
                            src={mapsEmbedUrl}></iframe>
                        <div
                            class="absolute bottom-0 left-0 w-full p-2 bg-white/80 dark:bg-black/60 backdrop-blur-sm text-center"
                        >
                            <span
                                class="text-xs text-neutral-600 dark:text-white/70"
                                >Ubicación aproximada</span
                            >
                        </div>
                    </div>

                    {/* Schedule (Horarios) - Below Map */}
                    <div
                        class="bg-neutral-50 dark:bg-black/20 p-6 rounded-xl border border-neutral-200 dark:border-white/10 backdrop-blur-sm shadow-sm"
                    >
                        <h3
                            class="text-neutral-900 dark:text-white font-bold mb-4 flex items-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 mr-2 text-yellow-400"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                            Horarios
                        </h3>
                        <ul class="space-y-3 text-sm text-white/70">
                            <li
                                class="flex justify-between border-b border-neutral-200 dark:border-white/5 pb-2"
                            >
                                <span>Lun - Vie</span>
                                <span
                                    class="font-medium text-neutral-900 dark:text-white"
                                    >9:00 AM - 8:00 PM</span
                                >
                            </li>
                            <li
                                class="flex justify-between border-b border-neutral-200 dark:border-white/5 pb-2"
                            >
                                <span>Sábado</span>
                                <span
                                    class="font-medium text-neutral-900 dark:text-white"
                                    >10:00 AM - 6:00 PM</span
                                >
                            </li>
                            <li class="flex justify-between pt-1">
                                <span class="text-red-500 dark:text-red-300"
                                    >Domingo</span
                                >
                                <span>Cerrado</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            {/* Menu / Catalog Section (Full Width Below Grid) */}
            <div
                class="p-8 border-t border-neutral-200 dark:border-white/5 bg-neutral-50 dark:bg-black/10"
            >
                <h2
                    class="text-2xl font-bold text-neutral-900 dark:text-white mb-6 flex items-center"
                >
                    {
                        business.category === "Gastronomía" ? (
                            <>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6 mr-3 text-orange-400"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                    />
                                </svg>
                                Menú Destacado
                            </>
                        ) : (
                            <>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6 mr-3 text-blue-400"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                                    />
                                </svg>
                                Servicios / Catálogo
                            </>
                        )
                    }
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                    <div
                        class="bg-white dark:bg-white/5 p-4 rounded-lg flex items-center space-x-4 hover:bg-neutral-50 dark:hover:bg-white/10 transition-colors cursor-pointer border border-neutral-200 dark:border-white/5 shadow-sm"
                    >
                        <div
                            class="w-16 h-16 bg-neutral-100 dark:bg-white/10 rounded-md flex items-center justify-center text-2xl"
                        >
                            ✨
                        </div>
                        <div>
                            <h4
                                class="text-neutral-900 dark:text-white font-bold"
                            >
                                {
                                    business.category === "Gastronomía"
                                        ? "Especialidad de la Casa"
                                        : "Producto Estrella"
                                }
                            </h4>
                            <p
                                class="text-xs text-neutral-500 dark:text-white/50"
                            >
                                Lo más solicitado por nuestros clientes.
                            </p>
                        </div>
                    </div>
                    <div
                        class="bg-white dark:bg-white/5 p-4 rounded-lg flex items-center space-x-4 hover:bg-neutral-50 dark:hover:bg-white/10 transition-colors cursor-pointer border border-neutral-200 dark:border-white/5 shadow-sm"
                    >
                        <div
                            class="w-16 h-16 bg-neutral-100 dark:bg-white/10 rounded-md flex items-center justify-center text-2xl"
                        >
                            🔥
                        </div>
                        <div>
                            <h4
                                class="text-neutral-900 dark:text-white font-bold"
                            >
                                {
                                    business.category === "Gastronomía"
                                        ? "Bebida Recomendada"
                                        : "Servicio Premium"
                                }
                            </h4>
                            <p
                                class="text-xs text-neutral-500 dark:text-white/50"
                            >
                                La mejor opción para complementar.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="text-center">
                    <a
                        href={whatsappLink}
                        class="inline-block text-blue-600 dark:text-blue-300 hover:text-blue-800 dark:hover:text-blue-100 underline decoration-blue-500/30 hover:decoration-blue-300 transition-all font-medium"
                    >
                        Consultar disponibilidad y precios actuales &rarr;
                    </a>
                </div>
            </div>

            {/* Bottom QR Code Section */}
            <div
                class="relative p-10 flex flex-col items-center justify-center text-center border-t border-neutral-200 dark:border-white/5 bg-gradient-to-b from-neutral-100 to-neutral-200 dark:from-black/40 dark:to-black/80"
            >
                {/* Decoration */}
                <div
                    class="absolute inset-0 bg-blue-500/5 blur-3xl pointer-events-none"
                >
                </div>

                <h3
                    class="relative text-neutral-900 dark:text-white font-black text-3xl mb-3 tracking-tight"
                >
                    ¡Llévanos contigo!
                </h3>
                <p
                    class="relative text-neutral-600 dark:text-white/60 mb-8 max-w-md mx-auto text-lg"
                >
                    Escanea este código para tener la información de <b
                        >{business.name}</b
                    > siempre a la mano.
                </p>

                <div
                    class="relative bg-white p-4 rounded-3xl shadow-2xl shadow-blue-500/20 border-4 border-neutral-100 dark:border-white/10 inline-block mb-6 transform hover:scale-105 transition-transform duration-300 group"
                >
                    <div
                        class="absolute inset-0 border-2 border-dashed border-neutral-300 rounded-2xl m-2 pointer-events-none"
                    >
                    </div>
                    <img
                        src={qrCodeDataUri}
                        alt={`QR Code para ${business.name}`}
                        class="w-56 h-56 mx-auto relative z-10"
                        width="224"
                        height="224"
                    />
                </div>

                <span
                    class="relative inline-flex items-center px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-500/20 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-500/30 text-sm font-bold uppercase tracking-wider backdrop-blur-md mb-6"
                >
                    {business.name}
                </span>

                {/* Share Button (Action) */}
                <button
                    id="share-btn"
                    class="relative inline-flex items-center justify-center px-6 py-3 bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-bold rounded-xl hover:bg-neutral-700 dark:hover:bg-neutral-200 transition-colors shadow-lg z-10"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 mr-2"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                        ></path>
                    </svg>
                    Compartir Perfil
                </button>
            </div>
        </div>
    </main>

    <script
        define:vars={{
            qrCodeDataUri,
            businessName: business.name,
            url: currentUrl,
        }}
    >
        const shareBtn = document.getElementById("share-btn");

        shareBtn?.addEventListener("click", async () => {
            try {
                // Convert Data URI to Blob
                const response = await fetch(qrCodeDataUri);
                const blob = await response.blob();
                const file = new File([blob], "qr-code.png", {
                    type: "image/png",
                });
                const shareData = {
                    title: businessName,
                    text: `¡Mira este negocio en Mercadotez! ${businessName}`,
                    url: url,
                };

                // Add file if supported
                if (
                    navigator.canShare &&
                    navigator.canShare({ files: [file] })
                ) {
                    shareData.files = [file];
                }

                if (navigator.share) {
                    await navigator.share(shareData);
                } else {
                    throw new Error("Web Share API not supported");
                }
            } catch (error) {
                console.log("Error sharing:", error);
                // Fallback: Copy URL to clipboard
                navigator.clipboard
                    .writeText(url)
                    .then(() => {
                        alert("¡Enlace copiado al portapapeles!");
                    })
                    .catch((err) => {
                        console.error("Failed to copy text: ", err);
                    });
            }
        });
    </script>
</Layout>

<style>
    .animate-fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }

    @keyframes fadeInUp {
        to {
            opacity: 1;
