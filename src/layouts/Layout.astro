---
import "../styles/global.css";
import ChatWidget from "../components/ChatWidget";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/pwa-192x192.png" />
		<link rel="mask-icon" href="/favicon.svg" color="#2563eb" />
		<meta name="theme-color" content="#2563eb" />
		<meta name="generator" content={Astro.generator} />
		<title>{Astro.props.title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		{/* PWA Registration */}
		<script>
			import { registerSW } from "virtual:pwa-register";
			registerSW({
				immediate: true,
			});
		</script>
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="bg-slate-50 dark:bg-neutral-950 text-neutral-900 dark:text-white font-inter antialiased transition-colors duration-300"
	>
		<slot />
		<ChatWidget client:load />
	</body>
</html>

<style is:global>
	:root {
		font-family: "Inter", sans-serif;
	}
	/* Remove hardcoded background to let Tailwind handle it */
</style>
